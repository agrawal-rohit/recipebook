{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"files": {
		"includes": [
			"packages/**/*.{js,ts,jsx,tsx,json,cjs,mjs,yaml,css}",
			"!packages/*/dist",
			"!packages/*/coverage",
			"!packages/registry/registry",
			"!packages/registry/registry.json",
			"!packages/registry/r",
			"!packages/cli/registry.json",
			"!packages/cli/r",
			"docs/**/*.{js,ts,tsx,mjs,json,css}",
			"!docs/node_modules",
			"!docs/.next",
			"!docs/.source",
			"!docs/dist",
			"!docs/build"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
