{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"files": {
		"includes": [
			"packages/**/*.{js,ts,jsx,tsx,json,cjs,mjs,yaml,css}",
			"!packages/*/dist",
			"!packages/*/coverage",
			"docs/**/*.{js,ts,tsx,mjs,json,css}",
			"!docs/node_modules",
			"!docs/.next",
			"!docs/.source",
			"!docs/dist",
			"!docs/build"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["docs/**"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			},
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noImportantStyles": "off",
						"useLiteralKeys": "off"
					}
				}
			}
		}
	]
}
