{
	"id": "package-management-configuration",
	"title": "Package Management",
	"description": "Supply-chain hardened package management configuration",
	"type": "configuration",
	"requires": [
		"language"
	],
	"packs": [
		{
			"id": "typescript-npm",
			"title": "npm",
			"when": {
				"language": "typescript",
				"packageManager": "npm"
			},
			"files": [
				{
					"source": "typescript/npm/.npmrc",
					"target": ".npmrc"
				}
			]
		},
		{
			"id": "typescript-pnpm",
			"title": "pnpm",
			"when": {
				"language": "typescript",
				"packageManager": "pnpm"
			},
			"files": [
				{
					"source": "typescript/pnpm/pnpm-workspace.yaml",
					"target": "pnpm-workspace.yaml"
				}
			]
		},
		{
			"id": "typescript-yarn",
			"title": "yarn",
			"when": {
				"language": "typescript",
				"packageManager": "yarn"
			},
			"files": [
				{
					"source": "typescript/yarn/.yarnrc.yml",
					"target": ".yarnrc.yml"
				}
			]
		},
		{
			"id": "typescript-bun",
			"title": "bun",
			"when": {
				"language": "typescript",
				"packageManager": "bun"
			},
			"files": [
				{
					"source": "typescript/bun/bunfig.toml",
					"target": "bunfig.toml"
				}
			]
		},
		{
			"id": "typescript-nub",
			"title": "nub",
			"when": {
				"language": "typescript",
				"packageManager": "nub"
			},
			"files": [
				{
					"source": "typescript/nub/nub.jsonc",
					"target": "nub.jsonc"
				}
			]
		}
	]
}
