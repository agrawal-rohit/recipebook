{
	"id": "testing-configuration",
	"title": "Testing",
	"description": "Testing configuration with coverage and mutation testing.",
	"type": "configuration",
	"requires": [
		"language",
		"defaultBranch"
	],
	"dependsOn": [
		"setup-workspace-workflow",
		"package-management-configuration",
		"test-quality-agent-instruction"
	],
	"packs": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"when": {
				"language": "typescript"
			},
			"dependencies": {
				"npm": {
					"dev": [
						"vitest@^3",
						"@vitest/coverage-v8@^3",
						"@stryker-mutator/core@^9.6.1",
						"@stryker-mutator/vitest-runner@^9.6.1",
						"@stryker-mutator/typescript-checker@^9.6.1"
					]
				}
			},
			"commands": {
				"npm": {
					"test": "vitest run",
					"cov": "vitest run --coverage --passWithNoTests",
					"mutate": "stryker run",
					"mutate:changed": "stryker run --incremental --mutate \\\"src/**/*.{ts,tsx},!src/**/*.{test,spec}.{ts,tsx}\\\""
				}
			},
			"files": [
				{
					"source": "typescript/vitest.config.ts",
					"target": "vitest.config.ts"
				},
				{
					"source": "typescript/stryker.config.mjs",
					"target": "stryker.config.mjs"
				},
				{
					"source": "typescript/.github/workflows/test.yml",
					"target": ".github/workflows/test.yml"
				}
			]
		}
	]
}
