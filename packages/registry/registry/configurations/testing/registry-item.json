{
	"id": "testing-configuration",
	"title": "Testing",
	"description": "Testing configuration with coverage and mutation testing.",
	"type": "configuration",
	"requires": [
		"language",
		"defaultBranch"
	],
	"conditions": {
		"coverageThreshold": {
			"kind": "text",
			"required": true,
			"label": "Coverage line threshold",
			"description": "Minimum line coverage percentage required.",
			"default": "80"
		}
	},
	"dependsOn": [
		"setup-workspace-workflow",
		"package-management-configuration"
	],
	"packs": [
		{
			"id": "typescript",
			"title": "TypeScript",
			"when": {
				"language": "typescript"
			},
			"dependencies": {
				"npm": {
					"dev": [
						"vitest@^3",
						"@vitest/coverage-v8@^3",
						"@stryker-mutator/core@^9",
						"@stryker-mutator/vitest-runner@^9",
						"@stryker-mutator/typescript-checker@^9"
					]
				}
			},
			"commands": {
				"npm": {
					"test": "vitest run",
					"cov": "vitest run --coverage --passWithNoTests",
					"mutate": "stryker run"
				}
			},
			"files": [
				{
					"source": "typescript/vitest.config.ts",
					"target": "vitest.config.ts"
				},
				{
					"source": "typescript/stryker.config.mjs",
					"target": "stryker.config.mjs"
				},
				{
					"source": "typescript/.github/workflows/test.yml",
					"target": ".github/workflows/test.yml"
				}
			]
		}
	]
}
