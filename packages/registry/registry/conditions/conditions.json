{
	"language": {
		"kind": "select",
		"required": true,
		"label": "Language",
		"description": "Language for the project.",
		"handler": "conditions/language.handler.ts",
		"values": [
			{
				"value": "typescript",
				"label": "TypeScript",
				"bindings": {
					"codeqlLanguages": "javascript-typescript"
				}
			}
		]
	},
	"authorName": {
		"kind": "text",
		"required": true,
		"label": "Author name",
		"description": "Who should be credited as author?",
		"handler": "conditions/author-name.handler.ts"
	},
	"githubUsername": {
		"kind": "text",
		"required": true,
		"label": "GitHub username or org",
		"description": "GitHub owner used in repository URLs.",
		"handler": "conditions/github-username.handler.ts"
	},
	"projectName": {
		"kind": "text",
		"required": true,
		"label": "Project name",
		"description": "Project name (e.g. foobar, @org/foobar)."
	},
	"defaultBranch": {
		"kind": "text",
		"required": true,
		"label": "Default branch",
		"description": "Primary branch name for workflows and Dependabot.",
		"handler": "conditions/default-branch.handler.ts"
	},
	"codingAgentIDE": {
		"kind": "select",
		"required": true,
		"label": "Coding agent",
		"description": "Which coding agent or IDE should instructions target?",
		"handler": "conditions/ide-format.handler.ts",
		"values": [
			{ "value": "cursor", "label": "Cursor" },
			{ "value": "claude-code", "label": "Claude Code" },
			{ "value": "copilot", "label": "GitHub Copilot" },
			{ "value": "codex", "label": "OpenAI Codex" },
			{ "value": "opencode", "label": "OpenCode" }
		]
	}
}
