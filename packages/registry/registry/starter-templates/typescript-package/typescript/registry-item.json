{
	"id": "typescript-package-starter-template",
	"title": "TypeScript Package",
	"description": "A TypeScript package starter template with sensible defaults and support for publishing to a package registry.",
	"type": "starter-template",
	"requires": [
		"language",
		"authorName",
		"githubUsername",
		"projectName"
	],
	"conditions": {
		"packageKind": {
			"kind": "select",
			"required": true,
			"label": "Package kind",
			"description": "Which type of TypeScript package should we scaffold?",
			"default": "basic",
			"values": [
				{
					"value": "basic",
					"label": "Basic library"
				},
				{
					"value": "react",
					"label": "React component library",
					"bindings": {
						"hasPlayground": "true"
					}
				}
			]
		},
		"packageDescription": {
			"kind": "text",
			"label": "Package description",
			"description": "Short package description (optional)."
		},
		"publishToNpm": {
			"kind": "boolean",
			"required": true,
			"label": "Publish to NPM",
			"description": "Publish this package to NPM?",
			"default": true
		},
		"initializeGit": {
			"kind": "boolean",
			"label": "Initialize git repository",
			"description": "Initialize git in the new package directory?",
			"default": true
		}
	},
	"dependsOn": [
		"issue-templates-configuration",
		"pr-template-configuration",
		"code-of-conduct-configuration",
		"license-configuration",
		"pre-commit-hooks-configuration",
		"testing-configuration",
		"dependency-updates-configuration",
		"setup-workspace-workflow",
		"build-package-workflow",
		"release-package-workflow",
		"repository-settings-workflow",
		"code-quality-workflow",
		"security-checks-workflow",
		"assign-owner-workflow",
		"code-standards-agent-instruction",
		"typescript-agent-instruction"
	],
	"dependencies": {
		"npm": {
			"dev": [
				"tsdown@^0.15",
				"typescript@^5",
				"@types/node@^24"
			]
		}
	},
	"commands": {
		"npm": {
			"build": "tsdown",
			"dev": "tsdown --watch",
			"typecheck": "tsc --noEmit"
		}
	},
	"afterInstall": [
		"initialize-git.after-install.ts"
	],
	"files": [
		{
			"source": "package.template.json",
			"target": "{{projectName}}/package.json"
		},
		{
			"source": ".gitignore",
			"target": "{{projectName}}/.gitignore"
		},
		{
			"source": "README.md",
			"target": "{{projectName}}/README.md"
		},
		{
			"source": "CONTRIBUTING.md",
			"target": "{{projectName}}/CONTRIBUTING.md"
		}
	],
	"packs": [
		{
			"id": "basic",
			"title": "Basic library",
			"when": {
				"language": "typescript",
				"packageKind": "basic"
			},
			"files": [
				{
					"source": "basic",
					"target": "{{projectName}}"
				}
			]
		},
		{
			"id": "react",
			"title": "React library",
			"when": {
				"language": "typescript",
				"packageKind": "react"
			},
			"dependsOn": [
				"react-agent-instruction",
				"react-app-starter-template"
			],
			"beforeWrite": [
				"react-playground.before-write.ts"
			],
			"dependencies": {
				"npm": {
					"dev": [
						"@testing-library/jest-dom@^6",
						"@testing-library/react@^16",
						"happy-dom@^20"
					]
				}
			},
			"files": [
				{
					"source": "react",
					"target": "{{projectName}}"
				}
			]
		}
	]
}
