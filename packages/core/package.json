{
	"name": "@cheetos/core",
	"version": "0.2.1",
	"description": "Shared primitives and utilities for building a `cheetos` registry",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"default": "./dist/browser.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"esbuild": "0.25.0",
		"mustache": "^4.2.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/mustache": "^4.2.6"
	}
}
