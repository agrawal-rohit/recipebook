{
	"name": "yoinker",
	"version": "0.2.1",
	"description": "A CLI for consuming yoinker code registries.",
	"license": "MIT",
	"bin": {
		"yoinker": "./bin/cli.mjs"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"build": "pnpm --filter @yoinker/core run build && tsc -p tsconfig.json",
		"typecheck": "pnpm --filter @yoinker/core run build && tsc -p tsconfig.json --noEmit",
		"test": "pnpm run build && vitest run",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@clack/core": "1.4.3",
		"@clack/prompts": "^1.7.0",
		"@yoinker/core": "workspace:*",
		"cac": "^6.7.14",
		"chalk": "^5.6.2",
		"listr2": "^10.1.0"
	}
}
