{
	"version": "0.2.1",
	"name": "recipebook-workspace",
	"type": "module",
	"description": "Workspace for the recipebook CLI and core library.",
	"author": "Rohit Agrawal <https://github.com/agrawal-rohit>",
	"repository": "https://github.com/agrawal-rohit/recipebook",
	"homepage": "https://github.com/agrawal-rohit/recipebook#readme",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"bugs": "https://github.com/agrawal-rohit/recipebook/issues",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"test": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./packages/*\" run test",
		"mutate": "stryker run",
		"mutate:changed": "stryker run --incremental --mutate \"packages/*/src/**/*.ts,!packages/*/src/**/*.test.ts,!packages/*/src/**/*.spec.ts\"",
		"typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
		"lint": "pnpm exec biome lint --write",
		"format": "pnpm exec biome format --write",
		"check": "pnpm run typecheck && pnpm exec biome check --write --no-errors-on-unmatched",
		"cov": "pnpm --filter @recipebook/core run build && vitest run --coverage --passWithNoTests",
		"quality": "fallow",
		"quality:changes": "fallow audit --format compact",
		"prepack": "pnpm --filter recipebook run prepack",
		"prepare": "husky",
		"docs:dev": "pnpm --filter docs run dev",
		"docs:build": "pnpm --filter docs run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/typescript-checker": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"fallow": "^3.27.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"pnpm": {
		"overrides": {
			"ajv": ">=8.18.0",
			"brace-expansion@^1": "1.1.18",
			"brace-expansion@^2": "2.1.4",
			"brace-expansion@^5": "5.0.9"
		}
	}
}
