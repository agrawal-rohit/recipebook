{
	"version": "0.2.1",
	"name": "yehle",
	"description": "An opinionated scaffolding CLI for the modern developer",
	"bin": "./bin/cli.mjs",
	"files": [
		"dist",
		"bin",
		"README.md",
		"LICENSE"
	],
	"author": "Rohit Agrawal <https://github.com/agrawal-rohit>",
	"repository": "https://github.com/agrawal-rohit/yehle",
	"homepage": "https://github.com/agrawal-rohit/yehle#readme",
	"license": "MIT",
	"private": false,
	"bugs": "https://github.com/agrawal-rohit/yehle/issues",
	"scripts": {
		"test": "vitest",
		"test-mutations": "stryker run",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm exec biome lint --write",
		"format": "pnpm exec biome format --write",
		"check": "pnpm run typecheck && pnpm exec biome check --write",
		"check:ci": "pnpm run typecheck && pnpm -C docs typecheck && pnpm exec biome check",
		"cov": "vitest run --coverage --passWithNoTests",
		"prepack": "pnpm run build",
		"prepare": "husky",
		"docs:dev": "pnpm -C docs dev",
		"docs:build": "pnpm -C docs build",
		"docs:start": "pnpm -C docs start",
		"docs:mdx": "pnpm -C docs mdx",
		"docs:typecheck": "pnpm -C docs typecheck"
	},
	"dependencies": {
		"cac": "^7.0.0",
		"chalk": "^6.0.0",
		"consola": "^3.2.3",
		"giget": "^3.3.1",
		"gray-matter": "^4.0.3",
		"listr2": "^11.1.0",
		"mustache": "^4.2.0",
		"spdx-license-list": "^6.12.0",
		"validate-npm-package-name": "8.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^20.4.4",
		"@commitlint/config-conventional": "^20.4.4",
		"@stryker-mutator/core": "^9.6.0",
		"@stryker-mutator/typescript-checker": "^9.6.0",
		"@stryker-mutator/vitest-runner": "^9.6.0",
		"@types/jest": "^30.0.0",
		"@types/mustache": "^4.2.5",
		"@types/node": "^24.3.1",
		"@types/validate-npm-package-name": "^4.0.2",
		"@vitest/coverage-v8": "3.2.4",
		"git-cliff": "^2.10.1",
		"glob": ">=10.5.0",
		"husky": "^9.1.7",
		"jest": "^30.1.3",
		"lint-staged": "^16.1.6",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"pnpm": {
		"overrides": {
			"ajv": ">=8.18.0"
		}
	}
}
