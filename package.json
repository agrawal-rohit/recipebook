{
	"version": "0.2.1",
	"name": "cheetos-workspace",
	"type": "module",
	"description": "Workspace for the cheetos CLI, core library, and default registry.",
	"author": "Rohit Agrawal <https://github.com/agrawal-rohit>",
	"repository": "https://github.com/agrawal-rohit/cheetos",
	"homepage": "https://github.com/agrawal-rohit/cheetos#readme",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"bugs": "https://github.com/agrawal-rohit/cheetos/issues",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"build:registry": "pnpm --filter @cheetos/registry run build",
		"test": "pnpm -r --filter \"./packages/*\" run test",
		"test-mutations": "stryker run",
		"typecheck": "pnpm -r --filter \"./packages/*\" run typecheck && pnpm -C docs typecheck",
		"lint": "pnpm exec biome lint --write",
		"format": "pnpm exec biome format --write",
		"check": "pnpm run typecheck && pnpm exec biome check --write --no-errors-on-unmatched",
		"cov": "pnpm --filter @cheetos/core run build && vitest run --coverage --passWithNoTests",
		"quality": "fallow",
		"quality:changes": "fallow audit --format compact",
		"prepack": "pnpm --filter cheetos run prepack",
		"prepare": "husky",
		"docs:dev": "pnpm -C docs dev",
		"docs:build": "pnpm -C docs build",
		"docs:start": "pnpm -C docs start",
		"docs:mdx": "pnpm -C docs mdx",
		"docs:typecheck": "pnpm -C docs typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^20.4.4",
		"@commitlint/config-conventional": "^20.4.4",
		"@stryker-mutator/core": "^9.6.0",
		"@stryker-mutator/typescript-checker": "^9.6.0",
		"@stryker-mutator/vitest-runner": "^9.6.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.3.1",
		"@vitest/coverage-v8": "3.2.4",
		"fallow": "^3.16.0",
		"husky": "^9.1.7",
		"jest": "^30.1.3",
		"lint-staged": "^16.1.6",
		"tsx": "^4.20.5",
		"typescript": "^6.0.3",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"pnpm": {
		"overrides": {
			"ajv": ">=8.18.0",
			"brace-expansion@^1": "1.1.18",
			"brace-expansion@^2": "2.1.4",
			"brace-expansion@^5": "5.0.9"
		}
	}
}
